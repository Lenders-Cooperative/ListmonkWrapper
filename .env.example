# -------------------------
# Listmonk App Settings
# -------------------------
LISTMONK_HOST=http://localhost
LISTMONK_PORT=9000

# Admin user / api user created automatically if these are set
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=admin123
LISTMONK_ADMIN_API_USER=api_admin

# -------------------------
# Postgres (internal, for docker-compose only)
# These are used by the Listmonk DB container inside docker-compose.
# -------------------------
POSTGRES_DB=listmonk
POSTGRES_USER=listmonk
POSTGRES_PASSWORD=listmonk
POSTGRES_PORT=9432
POSTGRES_HOST=localhost
